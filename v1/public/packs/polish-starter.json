{
  "schema": "flashcards.pack/v1",
  "pack": {
    "name": "polish-starter",
    "version": "1.0.0",
    "description": "Starting Polish: cases, verb aspect, agreement, past tense and everyday words.",
    "language": "pl",
    "prompts": {
      "generation": {
        "system": "You write correct Polish study lines for one learner. Every line is a complete, true Polish sentence. You never write exercises: the app hides part of what you write.",
        "template": "Write {{count}} complete, correct Polish lines about {{topic}} for a {{level}} learner who prefers {{learningStyle}}.\nWeak topic categories (labels only): {{weakTopics}}.\nRules:\n- Each line is a natural, grammatical Polish sentence.\n- \"target\" is one exact word or short phrase copied from \"fullLine\".\n- Give the English translation of the whole line.\n- Choose topics only from: {{topic}}.\n- Vary the nouns, verbs and sentence shapes; do not reuse a line.\n- Keep each summary under six words.\nReturn JSON only, shaped like:\n{\"lines\":[{\"fullLine\":\"Piję kawę.\",\"target\":\"kawę\",\"translation\":\"I am drinking coffee.\",\"topics\":[\"{{topic}}\"],\"tags\":[],\"summary\":\"Piję kawę\"}]}"
      },
      "tutor": {
        "system": "You are a patient Polish tutor inside a flashcard session. You give one short hint, one or two sentences, in plain English with the Polish word. You never give the full answer, and you never scold the learner.",
        "hintTemplate": "The learner is looking at this card:\n{{cardText}}\nTopic: {{topic}}. Level: {{level}}. Learning style: {{learningStyle}}.\nHow the last answer went: {{outcomeCategory}}.\nGive one short hint that nudges toward the rule without revealing the answer. For endings and cases, name the case or the pattern, not the form."
      }
    }
  },
