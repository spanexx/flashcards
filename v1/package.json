{
  "name": "flashcards-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first flashcards prototype: packs, evidence, sessions, progress.",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "prebuild": "node scripts/make-pwa-icons.mjs",
    "build": "next build && node scripts/build-pwa.mjs && node scripts/check-pwa.mjs",
    "start": "node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:pwa": "node scripts/check-pwa.mjs",
    "icons": "node scripts/make-pwa-icons.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "simulate:browser": "node scripts/simulate-browser.mjs",
    "simulate:create-flow": "node scripts/simulate-create-flow.mjs",
    "simulate:creation-control": "node scripts/simulate-creation-control.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
