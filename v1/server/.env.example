# WHY: Every name the service reads, with no value that is a secret. Copy this
# file to an environment store you control; never commit the filled copy.
# PACK: system-provider-subscription
# 2026-10-28 qoder: created for the paid system provider. [pack: system-provider-subscription]

# Where the service listens. Bind all interfaces when the browser is elsewhere.
PORT=8787

# The public app address. Its origin is the only CORS origin, and return links
# resolve against this path. A trailing slash is added for you.
APP_URL=https://owner.github.io/flashcards/

# What the Settings card calls this provider. Display only.
SYSTEM_PROVIDER_NAME=Flashcards Tutor
# A short price sentence, e.g. EUR 5 / month. Display only.
SYSTEM_PRICE_LABEL=EUR 5 / month

# Stripe (server only). Set both to sell, neither to stay read-only.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional. Without it the webhook endpoint answers 404 and the cache waits
# out its two-minute window instead of being cleared early.
STRIPE_WEBHOOK_SECRET=
# Tests only; leave unset to use https://api.stripe.com.
# STRIPE_API_BASE=

# At least 32 characters. Signs every learner pass; changing it invalidates
# every pass already issued.
LICENSE_SECRET=
# Optional. Default 2592000 (30 days).
# LICENSE_TTL_SECONDS=

# The one model every subscriber reaches (server only). Set all three or none.
SYSTEM_LLM_BASE_URL=
SYSTEM_LLM_MODEL=
SYSTEM_LLM_API_KEY=
# Optional. Default 60000.
# UPSTREAM_TIMEOUT_MS=

# Optional. Requests per hour per pass and address. Default 120.
# RATE_LIMIT_PER_HOUR=
# Optional. Relay calls per hour per address. The relay needs no secret and is
# open to anyone with their own provider key, so this is the guard on the box.
# Default 60.
# RELAY_RATE_LIMIT_PER_HOUR=
# Optional. Millisecond lifetime of a subscription status in memory. Default 120000.
# SUBSCRIPTION_CACHE_MS=

# Subscription recovery (server only). Set all three together or none: the form
# appears and links are sent only when the group is complete. Recovery also
# needs STRIPE_SECRET_KEY, because Stripe is the record of who subscribed.
# The Brevo API key from a verified sender account.
BREVO_API_KEY=
# At least 32 characters. Signs the one-time links; rotating it only makes
# links already in an inbox stop working.
RECOVERY_SECRET=
# The sender address you verified with Brevo. No domain is needed.
RECOVERY_FROM_EMAIL=
# Optional. The sender name a learner sees. Default "Study tutor".
# RECOVERY_FROM_NAME=
# Optional. Minutes a link stays useful, in seconds. Default 1800.
# RECOVERY_TOKEN_TTL_SECONDS=
# Optional. Link requests per hour per requester address. Default 5.
# RECOVERY_RATE_LIMIT_PER_HOUR=
# Optional. Seconds before the same email may ask again. Default 600.
# RECOVERY_EMAIL_COOLDOWN_SECONDS=
