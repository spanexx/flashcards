# WHY: npm 10's peer resolver walks into a null node when it meets vitest's
# optional browser peers. The app does not use those peers, so skipping peer
# auto-install is safe and keeps installation repeatable on Node 20.
# PACK: v1-prototype
# 2026-10-19 opencode: created for the v1 prototype [pack: v1-prototype]
legacy-peer-deps=true
